# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Public URL — REQUIRED for production and physical device testing.
# Set to your machine's LAN IP (e.g. http://192.168.1.42:4000) for device testing,
# or your production domain for deployment.
# PUBLIC_URL=http://192.168.1.42:4000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://repitair.com,https://www.repitair.com

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://repitair:repitair@localhost:5432/repitair

# ─── Redis (optional — enables multi-instance token blacklist) ────────────────
# REDIS_URL=redis://localhost:6379

# ─── Spotify API ──────────────────────────────────────────────────────────────
# Get credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Set to your backend's public URL + /api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://localhost:4000/api/auth/spotify/callback

# ─── Social Auth ──────────────────────────────────────────────────────────────
# Google Sign-In audiences expected by the backend when verifying mobile ID tokens.
# Use the native client IDs created in Google Cloud for the Repitair mobile app:
# - iOS client: bundle ID com.mauricemcbig.repitairapp
# - Android client: package com.mauricemcbig.repitairapp with the correct SHA-1
#
# Temporary fallback only during rollout. Remove once native sign-in is confirmed.
GOOGLE_CLIENT_ID=
# Native iOS Google OAuth client ID.
GOOGLE_IOS_CLIENT_ID=
# Native Android Google OAuth client ID.
GOOGLE_ANDROID_CLIENT_ID=
# Apple Sign-In audience expected by the backend when verifying mobile ID tokens.
# This is typically your app bundle identifier or Services ID.
APPLE_CLIENT_ID=

# ─── Admin Access ─────────────────────────────────────────────────────────────
# Comma-separated email allowlist for protected template/admin endpoints.
ADMIN_EMAILS=

# ─── Apple Music API ─────────────────────────────────────────────────────────
# Get credentials at: https://developer.apple.com/account/resources/authkeys/list
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Paste the full .p8 file contents with newlines replaced by \n
APPLE_MUSIC_PRIVATE_KEY=

# ─── Server URL ──────────────────────────────────────────────────────────────
# Public-facing API URL (used for Apple Music auth page redirect)
# API_BASE_URL=https://your-app.railway.app

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Used for password reset codes and contact form forwarding.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=Repitair <noreply@repitair.com>

# Destination for contact-form submissions.
# SUPPORT_EMAIL=support@repitair.app

# ─── Cloud Storage (S3) ──────────────────────────────────────────────────────
# Set UPLOAD_PROVIDER=s3 to use S3 instead of local disk storage.
# UPLOAD_PROVIDER=local
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Push Notifications ──────────────────────────────────────────────────────
# Get your access token at: https://expo.dev/accounts/[account]/settings/access-tokens
# EXPO_ACCESS_TOKEN=

# ─── Background Removal ──────────────────────────────────────────────────────
# Get an API key at: https://www.remove.bg/api
# REMOVE_BG_API_KEY=

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Trust proxy — required behind a load balancer for correct req.ip.
# TRUST_PROXY=1
