# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Swagger is enabled automatically outside production. Set true explicitly only
# when API documentation should be exposed in another controlled environment.
SWAGGER_ENABLED=true

# Public URL — REQUIRED for production and physical device testing.
# Set to your machine's LAN IP (e.g. http://192.168.1.42:4000) for device testing,
# or your production domain for deployment.
# PUBLIC_URL=http://192.168.1.42:4000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Use a separate secret from JWT_SECRET. Access tokens default to 15 minutes;
# rotating refresh sessions default to 30 days.
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://repitair.com,https://www.repitair.com

# Admin browser session. Production deployments must use HTTPS. Use SameSite=none
# only when the admin frontend and API are genuinely cross-site.
ADMIN_FRONTEND_ORIGIN=http://localhost:3002
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_PATH=/api/admin
# ADMIN_COOKIE_DOMAIN=

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://repitair:repitair@localhost:5432/repitair

# ─── Redis (optional — enables multi-instance token blacklist) ────────────────
# REDIS_URL=redis://localhost:6379

# ─── Spotify API ──────────────────────────────────────────────────────────────
# Get credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Set to your backend's public URL + /api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://localhost:4000/api/auth/spotify/callback

# Encrypts music-provider access tokens, refresh tokens, and OAuth PKCE state.
# Required in production. Generate 32 bytes as either base64 or 64 hex chars.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MUSIC_TOKEN_ENCRYPTION_KEY=

# Provider-account connections are a guarded staging feature. Both values are
# required; requests fail closed when disabled or when the user's email is not
# explicitly allowlisted. Public music-link parsing remains available.
MUSIC_PROVIDER_CONNECTIONS_ENABLED=false
MUSIC_PROVIDER_CONNECTION_ALLOWLIST=

# Public web origin used for shareable Repitair music collection links.
REPITAIR_WEB_BASE_URL=https://repitair.com

# ─── Social Auth ──────────────────────────────────────────────────────────────
# Google Sign-In audiences expected by the backend when verifying mobile ID tokens.
# Use the native client IDs created in Google Cloud for the Repitair mobile app:
# - iOS client: bundle ID com.mauricemcbig.repitairapp
# - Android client: package com.mauricemcbig.repitairapp with the correct SHA-1
#
# Temporary fallback only during rollout. Remove once native sign-in is confirmed.
GOOGLE_CLIENT_ID=
# Native iOS Google OAuth client ID.
GOOGLE_IOS_CLIENT_ID=
# Native Android Google OAuth client ID.
GOOGLE_ANDROID_CLIENT_ID=
# Apple Sign-In audience expected by the backend when verifying mobile ID tokens.
# This is typically your app bundle identifier or Services ID.
APPLE_CLIENT_ID=

# ─── Admin Access ─────────────────────────────────────────────────────────────
# Comma-separated email allowlist for protected template/admin endpoints.
ADMIN_EMAILS=

# ─── Apple Music API ─────────────────────────────────────────────────────────
# Get credentials at: https://developer.apple.com/account/resources/authkeys/list
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Paste the full .p8 file contents with newlines replaced by \n
APPLE_MUSIC_PRIVATE_KEY=

# ─── Server URL ──────────────────────────────────────────────────────────────
# Public-facing API URL (used for Apple Music auth page redirect)
# API_BASE_URL=https://your-app.railway.app

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Used for password resets, admin invitations, privacy exports, and contact forwarding.
# ─── Email delivery ─────────────────────────────────────────────────────────
# SendGrid HTTPS is recommended for hosts such as Railway where SMTP egress may
# be blocked. SMTP is used only when SENDGRID_API_KEY is absent.
# SENDGRID_API_KEY=
# SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send
# MAIL_HTTP_TIMEOUT_MS=8000
# SMTP_FROM=Repitair <noreply@repitair.com>
# The SMTP_FROM sender or domain must be verified with the email provider.
#
# Optional SMTP fallback:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Destination for contact-form submissions.
# SUPPORT_EMAIL=support@repitair.app

# ─── Cloud Storage (S3) ──────────────────────────────────────────────────────
# Set UPLOAD_PROVIDER=s3 to use S3 instead of local disk storage.
# UPLOAD_PROVIDER=local
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Push Notifications ──────────────────────────────────────────────────────
# Get your access token at: https://expo.dev/accounts/[account]/settings/access-tokens
# EXPO_ACCESS_TOKEN=

# ─── Background Removal ──────────────────────────────────────────────────────
# Provider selection (removebg | clipdrop | stub). Set to removebg for production;
# the stub is dev-only and is refused when NODE_ENV=production.
BG_REMOVAL_PROVIDER=removebg
# Get an API key at: https://www.remove.bg/api
# REMOVE_BG_API_KEY=
# Optional: upstream request timeout in ms (default 30000).
# BG_REMOVAL_TIMEOUT_MS=30000
# Optional: per-image cost (USD) for the admin cost estimate (default 0.20).
# MEDIA_COST_PER_IMAGE_REMOVE_BG=0.20
# Server-derived threshold before a queued media job is surfaced as delayed.
# MEDIA_QUEUE_DELAYED_MS=120000
# For Clipdrop instead: BG_REMOVAL_PROVIDER=clipdrop and CLIPDROP_API_KEY=...

# ─── Platform Jobs Worker ────────────────────────────────────────────────────
# Prefer a standalone worker service in deployed environments. The worker must
# share DATABASE_URL, storage credentials, and provider credentials with the API.
# Leave false on the API when a separate worker is deployed.
ENABLE_INLINE_WORKER=false
# Set automatically by src/worker.ts; API-only startup tasks skip worker processes.
# REPITAIR_PROCESS_ROLE=worker
# Set only on a dedicated media worker to avoid claiming unrelated queues.
# QUEUES=media

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Trust proxy — required behind a load balancer for correct req.ip.
# TRUST_PROXY=1
# Admin Back Office
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_MFA_TICKET_EXPIRES_IN=10m
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_BOOTSTRAP_EMAIL=admin@repitair.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
ADMIN_BOOTSTRAP_FULL_NAME=Repitair Super Admin
ADMIN_BOOTSTRAP_MFA_SECRET=JBSWY3DPEHPK3PXP
