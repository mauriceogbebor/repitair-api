{
  "name": "repitair-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npm run migration:run:prod && node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "npm run migration:run:prod && node dist/main.js",
    "build": "nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "tsc --noEmit -p tsconfig.build.json",
    "composition:backfill": "sh ./tools/run-composition-backfill.sh",
    "composition:report": "sh ./tools/run-composition-report.sh",
    "audioverse:provision:staging": "sh ./tools/run-audioverse-staging-provision.sh",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "start:worker": "node dist/worker.js",
    "worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "expo-server-sdk": "^3.15.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.4",
    "@nestjs/testing": "^11.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/uuid": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.11",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
