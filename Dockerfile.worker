# Standalone Platform Jobs worker image. It intentionally exposes no HTTP port
# and does not run migrations; deploy the API migration release before this
# service so only one process owns schema changes.
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY src ./src
COPY tsconfig*.json ./
COPY nest-cli.json ./
RUN npm run build

FROM node:20-alpine

WORKDIR /app
RUN apk add --no-cache dumb-init
COPY package*.json ./
COPY tools ./tools
RUN npm ci --only=production
COPY --from=builder /app/dist ./dist

ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "worker:prod"]
